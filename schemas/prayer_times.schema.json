{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrayerTimesCalculation",
  "type": "object",
  "required": ["latitude", "longitude", "date", "timezone", "timings", "method"],
  "properties": {
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "timezone": { "type": "string" },
    "method": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "fajr_angle": { "type": "number" },
        "isha_angle": { "type": "number" }
      }
    },
    "timings": {
      "type": "object",
      "required": ["Fajr", "Sunrise", "Dhuhr", "Asr", "Maghrib", "Isha"],
      "properties": {
        "Imsak": { "type": "string" },
        "Fajr": { "type": "string" },
        "Sunrise": { "type": "string" },
        "Dhuhr": { "type": "string" },
        "Asr": { "type": "string" },
        "Sunset": { "type": "string" },
        "Maghrib": { "type": "string" },
        "Isha": { "type": "string" },
        "Midnight": { "type": "string" }
      }
    }
  }
}
