{
  "names": [
    {"id": 1, "name_ar": "الرَّحْمَنُ", "name_en": "Ar-Rahman", "translation_en": "The Entirely Merciful", "meaning_ar": "الذي وسعت رحمته جميع الخلق في الدنيا، وهو ذو الرحمة العامة الشاملة."},
    {"id": 2, "name_ar": "الرَّحِيمُ", "name_en": "Ar-Raheem", "translation_en": "The Especially Merciful", "meaning_ar": "الذي يرحم المؤمنين برحمة خاصة في الدنيا والآخرة بالهداية والتوفيق والجنة."},
    {"id": 3, "name_ar": "الْمَلِكُ", "name_en": "Al-Malik", "translation_en": "The Sovereign, The King", "meaning_ar": "المتصرف في خلقه بأمره ونهيه، المالك لكل شيء بلا منازع."},
    {"id": 4, "name_ar": "الْقُدُّوسُ", "name_en": "Al-Quddus", "translation_en": "The Most Holy", "meaning_ar": "المنزه عن كل عيب ونقص، الطاهر من كل ما لا يليق بجلاله."},
    {"id": 5, "name_ar": "السَّلَامُ", "name_en": "As-Salam", "translation_en": "The Source of Peace", "meaning_ar": "السالم من كل نقص وعيب، ومانح السلام والأمان لعباده."},
    {"id": 6, "name_ar": "الْمُؤْمِنُ", "name_en": "Al-Mu'min", "translation_en": "The Granter of Security, The Affirmer of Truth", "meaning_ar": "المصدق لرسله بالمعجزات، الذي يؤمن عباده من الخوف والظلم."},
    {"id": 7, "name_ar": "الْمُهَيْمِنُ", "name_en": "Al-Muhaymin", "translation_en": "The Guardian, The Overseer", "meaning_ar": "الرقيب على كل شيء، القائم على أمور خلقه بالحفظ والرعاية."},
    {"id": 8, "name_ar": "الْعَزِيزُ", "name_en": "Al-Aziz", "translation_en": "The All-Mighty", "meaning_ar": "القوي الغالب الذي لا يُقهر ولا يُغلب، وله العزة كلها."},
    {"id": 9, "name_ar": "الْجَبَّارُ", "name_en": "Al-Jabbar", "translation_en": "The Compeller, The Restorer", "meaning_ar": "الذي يجبر قلوب المنكسرين ويغني الفقير، والنافذ أمره في كل شيء."},
    {"id": 10, "name_ar": "الْمُتَكَبِّرُ", "name_en": "Al-Mutakabbir", "translation_en": "The Supreme, The Majestic", "meaning_ar": "المتعالي عن صفات الخلق، صاحب الكبرياء والعظمة الحقة."},
    {"id": 11, "name_ar": "الْخَالِقُ", "name_en": "Al-Khaliq", "translation_en": "The Creator", "meaning_ar": "الموجد للأشياء من العدم على غير مثال سابق."},
    {"id": 12, "name_ar": "الْبَارِئُ", "name_en": "Al-Bari'", "translation_en": "The Maker, The Producer", "meaning_ar": "الذي أوجد الخلق بريئاً من التفاوت والنقص."},
    {"id": 13, "name_ar": "الْمُصَوِّرُ", "name_en": "Al-Musawwir", "translation_en": "The Fashioner", "meaning_ar": "الذي أعطى كل مخلوق صورته وشكله وهيئته الخاصة."},
    {"id": 14, "name_ar": "الْغَفَّارُ", "name_en": "Al-Ghaffar", "translation_en": "The All-Forgiving", "meaning_ar": "الكثير المغفرة لذنوب عباده مرة بعد أخرى."},
    {"id": 15, "name_ar": "الْقَهَّارُ", "name_en": "Al-Qahhar", "translation_en": "The Subduer", "meaning_ar": "الذي خضعت له الرقاب وذلت له الجبابرة، الغالب على أمره."},
    {"id": 16, "name_ar": "الْوَهَّابُ", "name_en": "Al-Wahhab", "translation_en": "The Bestower", "meaning_ar": "الكثير العطاء والجود بغير عوض ولا مسألة."},
    {"id": 17, "name_ar": "الرَّزَّاقُ", "name_en": "Ar-Razzaq", "translation_en": "The Provider", "meaning_ar": "المتكفل بأقوات جميع العباد والأحياء."},
    {"id": 18, "name_ar": "الْفَتَّاحُ", "name_en": "Al-Fattah", "translation_en": "The Opener, The Judge", "meaning_ar": "الذي يفتح أبواب الرحمة والرزق لعباده، والحاكم بينهم بالعدل."},
    {"id": 19, "name_ar": "الْعَلِيمُ", "name_en": "Al-Aleem", "translation_en": "The All-Knowing", "meaning_ar": "الذي أحاط علمه بكل شيء ظاهراً وباطناً، سراً وعلانية."},
    {"id": 20, "name_ar": "الْقَابِضُ", "name_en": "Al-Qabid", "translation_en": "The Withholder", "meaning_ar": "الذي يقبض الرزق والأرواح بحكمته وعدله."},
    {"id": 21, "name_ar": "الْبَاسِطُ", "name_en": "Al-Basit", "translation_en": "The Expander", "meaning_ar": "الذي يوسع الرزق والرحمة على من يشاء بفضله."},
    {"id": 22, "name_ar": "الْخَافِضُ", "name_en": "Al-Khafid", "translation_en": "The Abaser", "meaning_ar": "الذي يخفض الكفار والمتكبرين ويذلهم."},
    {"id": 23, "name_ar": "الرَّافِعُ", "name_en": "Ar-Rafi'", "translation_en": "The Exalter", "meaning_ar": "الذي يرفع أولياءه وأهل طاعته بالعلم والإيمان."},
    {"id": 24, "name_ar": "الْمُعِزُّ", "name_en": "Al-Mu'izz", "translation_en": "The Bestower of Honor", "meaning_ar": "الذي يهب العزة لمن يشاء من عباده."},
    {"id": 25, "name_ar": "الْمُذِلُّ", "name_en": "Al-Mudhill", "translation_en": "The Dishonorer", "meaning_ar": "الذي ينزع العزة ويذل من عصاه واستكبر."},
    {"id": 26, "name_ar": "السَّمِيعُ", "name_en": "As-Samee'", "translation_en": "The All-Hearing", "meaning_ar": "الذي يسمع كل الأصوات وسرائر القلوب بلا خفاء."},
    {"id": 27, "name_ar": "الْبَصِيرُ", "name_en": "Al-Baseer", "translation_en": "The All-Seeing", "meaning_ar": "الذي يرى كل شيء دقيقاً كان أو جليلاً في ظلمات البر والبحر."},
    {"id": 28, "name_ar": "الْحَكَمُ", "name_en": "Al-Hakam", "translation_en": "The Judge", "meaning_ar": "العدل الذي لا يظلم مثقال ذرة، وهو خير الحاكمين."},
    {"id": 29, "name_ar": "الْعَدْلُ", "name_en": "Al-Adl", "translation_en": "The Utterly Just", "meaning_ar": "المنزه عن الظلم والجور في أحكامه وأفعاله."},
    {"id": 30, "name_ar": "اللَّطِيفُ", "name_en": "Al-Lateef", "translation_en": "The Subtle, The Kind", "meaning_ar": "البر بعباده الذي يوصل إليهم الإحسان برفق وخفاء."},
    {"id": 31, "name_ar": "الْخَبِيرُ", "name_en": "Al-Khabeer", "translation_en": "The All-Aware", "meaning_ar": "العالم بحقائق الأشياء وبواطنها وخفايا الصدور."},
    {"id": 32, "name_ar": "الْحَلِيمُ", "name_en": "Al-Haleem", "translation_en": "The Most Forbearing", "meaning_ar": "الذي لا يعاجل بالعقوبة بل يمهل عباده ليتوبوا."},
    {"id": 33, "name_ar": "الْعَظِيمُ", "name_en": "Al-Azeem", "translation_en": "The Magnificent", "meaning_ar": "الذي له العظمة المطلقة في ذاته وصفاته وأفعاله."},
    {"id": 34, "name_ar": "الْغَفُورُ", "name_en": "Al-Ghafoor", "translation_en": "The Forgiving", "meaning_ar": "الساتر لذنوب عباده المتجاوز عن خطاياهم."},
    {"id": 35, "name_ar": "الشَّكُورُ", "name_en": "Ash-Shakoor", "translation_en": "The Most Appreciative", "meaning_ar": "الذي يجزي على العمل القليل بالثواب الجزيل."},
    {"id": 36, "name_ar": "الْعَلِيُّ", "name_en": "Al-Aliyy", "translation_en": "The Most High", "meaning_ar": "الذي له العلو المطلق علو القهر والشأن والذات."},
    {"id": 37, "name_ar": "الْكَبِيرُ", "name_en": "Al-Kabeer", "translation_en": "The Most Great", "meaning_ar": "صاحب الكبرياء الذي كل شيء دونه حقير وصغير."},
    {"id": 38, "name_ar": "الْحَفِيظُ", "name_en": "Al-Hafeez", "translation_en": "The Preserver", "meaning_ar": "الذي يحفظ الكون وخلقه وأعمال العباد فلا يضيع منها شيء."},
    {"id": 39, "name_ar": "الْمُقِيتُ", "name_en": "Al-Muqeet", "translation_en": "The Sustainer", "meaning_ar": "المتكفل بإيصال الأقوات وحفظ أبدان وأرواح الخلق."},
    {"id": 40, "name_ar": "الْحَسِيبُ", "name_en": "Al-Haseeb", "translation_en": "The Reckoner", "meaning_ar": "الكافي لعباده في كل أمورهم، والمحاسب لهم على أعمالهم."},
    {"id": 41, "name_ar": "الْجَلِيلُ", "name_en": "Al-Jaleel", "translation_en": "The Majestic", "meaning_ar": "الموصوف بنعوت الجلال والكمال وعظم الشأن."},
    {"id": 42, "name_ar": "الْكَرِيمُ", "name_en": "Al-Kareem", "translation_en": "The Most Generous", "meaning_ar": "الكثير الخير العظيم العطاء الذي يعطي دون انقطاع."},
    {"id": 43, "name_ar": "الرَّقِيبُ", "name_en": "Ar-Raqeeb", "translation_en": "The Watchful", "meaning_ar": "المطلع على ما أكنته الصدور والقائم على كل نفس بما كسبت."},
    {"id": 44, "name_ar": "الْمُجِيبُ", "name_en": "Al-Mujeeb", "translation_en": "The Responsive", "meaning_ar": "الذي يجيب دعاء الداعين وسؤال السائلين."},
    {"id": 45, "name_ar": "الْوَاسِعُ", "name_en": "Al-Wasi'", "translation_en": "The All-Encompassing", "meaning_ar": "الذي وسع علمه ورحمته وفضله ومغفرته كل شيء."},
    {"id": 46, "name_ar": "الْحَكِيمُ", "name_en": "Al-Hakeem", "translation_en": "The All-Wise", "meaning_ar": "الذي يضع الأشياء في مواضعها المتقنة بحكمته البالغة."},
    {"id": 47, "name_ar": "الْوَدُودُ", "name_en": "Al-Wadood", "translation_en": "The Most Loving", "meaning_ar": "المحب لأوليائه والمحبوب في قلوب عباده الصالحين."},
    {"id": 48, "name_ar": "الْمَجِيدُ", "name_en": "Al-Majeed", "translation_en": "The Glorious", "meaning_ar": "الواسع الكرم العظيم المجد والسلطان."},
    {"id": 49, "name_ar": "الْبَاعِثُ", "name_en": "Al-Ba'ith", "translation_en": "The Resurrector", "meaning_ar": "الذي يبعث الخلق بعد الموت للحساب والجزاء."},
    {"id": 50, "name_ar": "الشَّهِيدُ", "name_en": "Ash-Shaheed", "translation_en": "The All-and-Ever Witnessing", "meaning_ar": "المطلع على كل شيء الحاضر الذي لا يغيب عنه أمر."},
    {"id": 51, "name_ar": "الْحَقُّ", "name_en": "Al-Haqq", "translation_en": "The Absolute Truth", "meaning_ar": "الموجود حقاً الذي لا شك في وجوده وألوهيته ووعوده."},
    {"id": 52, "name_ar": "الْوَكِيلُ", "name_en": "Al-Wakeel", "translation_en": "The Trustee", "meaning_ar": "المتكفل بتدبير أمور خلقه القائم بمصالحهم."},
    {"id": 53, "name_ar": "الْقَوِيُّ", "name_en": "Al-Qawiyy", "translation_en": "The All-Strong", "meaning_ar": "صاحب القدرة التامة التي لا يلحقها عجز ولا وهن."},
    {"id": 54, "name_ar": "الْمَتِينُ", "name_en": "Al-Mateen", "translation_en": "The Firm, The Steadfast", "meaning_ar": "الشديد القوة الذي لا تنقطع قدرته ولا تلحقه مشقة."},
    {"id": 55, "name_ar": "الْوَلِيُّ", "name_en": "Al-Waliyy", "translation_en": "The Protecting Associate", "meaning_ar": "الناصر والمعين لأوليائه والمحب لهم."},
    {"id": 56, "name_ar": "الْحَمِيدُ", "name_en": "Al-Hameed", "translation_en": "The Praiseworthy", "meaning_ar": "المستحق لجميع المحامد والثناء في كل حال."},
    {"id": 57, "name_ar": "الْمُحْصِي", "name_en": "Al-Muhsee", "translation_en": "The All-Enumerating", "meaning_ar": "الذي أحاط بكل شيء علماً وأحصى كل شيء عدداً."},
    {"id": 58, "name_ar": "الْمُبْدِئُ", "name_en": "Al-Mubdi", "translation_en": "The Originator", "meaning_ar": "الذي بدأ خلق الأشياء واخترعها من غير مثال سابق."},
    {"id": 59, "name_ar": "الْمُعِيدُ", "name_en": "Al-Mu'eed", "translation_en": "The Restorer", "meaning_ar": "الذي يعيد الخلق بعد فنائه وموته إلى الحياة."},
    {"id": 60, "name_ar": "الْمُحْيِي", "name_en": "Al-Muhyee", "translation_en": "The Giver of Life", "meaning_ar": "الذي يبث الحياة في الأجساد ويحيي القلوب بالإيمان."},
    {"id": 61, "name_ar": "الْمُمِيتُ", "name_en": "Al-Mumeet", "translation_en": "The Creator of Death", "meaning_ar": "الذي يسلب الحياة بمشيئته وأجله المحدد."},
    {"id": 62, "name_ar": "الْحَيُّ", "name_en": "Al-Hayy", "translation_en": "The Ever-Living", "meaning_ar": "الباقي الدائم الذي لا يموت وله الحياة الكاملة."},
    {"id": 63, "name_ar": "الْقَيُّومُ", "name_en": "Al-Qayyoom", "translation_en": "The Sustainer of All", "meaning_ar": "القائم بنفسه المقيم لجميع خلقه بتدبيره."},
    {"id": 64, "name_ar": "الْوَاجِدُ", "name_en": "Al-Wajid", "translation_en": "The Perceiver, The Finder", "meaning_ar": "الذي لا يعوزه شيء ولا يفوته مراد."},
    {"id": 65, "name_ar": "الْمَاجِدُ", "name_en": "Al-Majid", "translation_en": "The Illustrious", "meaning_ar": "العظيم الشرف والكمال والكرم الواسع."},
    {"id": 66, "name_ar": "الْوَاحِدُ", "name_en": "Al-Wahid", "translation_en": "The One", "meaning_ar": "المتفرد في ذاته وصفاته وأفعاله بلا شريك."},
    {"id": 67, "name_ar": "الأَحَدُ", "name_en": "Al-Ahad", "translation_en": "The Unique", "meaning_ar": "الذي لا مثيل له ولا نظير في كماله وإلهيته."},
    {"id": 68, "name_ar": "الصَّمَدُ", "name_en": "As-Samad", "translation_en": "The Eternal Refuge", "meaning_ar": "السيد الذي تصمد إليه الخلائق وتقصده في حوائجها."},
    {"id": 69, "name_ar": "الْقَادِرُ", "name_en": "Al-Qadir", "translation_en": "The Capable", "meaning_ar": "صاحب القدرة المطلقة الذي لا يعجزه شيء في الأرض ولا في السماء."},
    {"id": 70, "name_ar": "الْمُقْتَدِرُ", "name_en": "Al-Muqtadir", "translation_en": "The Omnipotent", "meaning_ar": "المظهر لقدرته التامة في تصريف شؤون خلقه."},
    {"id": 71, "name_ar": "الْمُقَدِّمُ", "name_en": "Al-Muqaddim", "translation_en": "The Advancer", "meaning_ar": "الذي يقدم من يشاء من خلقه بحكمته وفضله."},
    {"id": 72, "name_ar": "الْمُؤَخِّرُ", "name_en": "Al-Mu'akhkhir", "translation_en": "The Delayer", "meaning_ar": "الذي يؤخر ما يشاء بحكمته ومقتضى عدله."},
    {"id": 73, "name_ar": "الأَوَّلُ", "name_en": "Al-Awwal", "translation_en": "The First", "meaning_ar": "الذي ليس قبله شيء وهو مبدأ كل موجود."},
    {"id": 74, "name_ar": "الآخِرُ", "name_en": "Al-Akhir", "translation_en": "The Last", "meaning_ar": "الباقي بعد فناء خلقه والذي ليس بعده شيء."},
    {"id": 75, "name_ar": "الظَّاهِرُ", "name_en": "Az-Zahir", "translation_en": "The Manifest", "meaning_ar": "الذي ظهرت آياته وحججه وقهر سلطانه كل شيء."},
    {"id": 76, "name_ar": "الْبَاطِنُ", "name_en": "Al-Batin", "translation_en": "The Hidden", "meaning_ar": "المحتجب عن أبصار خلقه العليم بخفايا الأمور."},
    {"id": 77, "name_ar": "الْوَالِي", "name_en": "Al-Waali", "translation_en": "The Sole Governor", "meaning_ar": "المالك للأشياء المتصرف فيها بمشيئته."},
    {"id": 78, "name_ar": "الْمُتَعَالِي", "name_en": "Al-Muta'ali", "translation_en": "The Self Exalted", "meaning_ar": "المتنزه عن صفات المخلوقين المرتفع عن كل نقص."},
    {"id": 79, "name_ar": "الْبَرُّ", "name_en": "Al-Barr", "translation_en": "The Source of All Goodness", "meaning_ar": "العطوف المحسن على خلقه الجزيل العطاء."},
    {"id": 80, "name_ar": "التَّوَّابُ", "name_en": "At-Tawwab", "translation_en": "The Ever-Pardoning", "meaning_ar": "الذي يقبل توبة التائبين ويوفقهم لها ويكفر عنهم."},
    {"id": 81, "name_ar": "الْمُنْتَقِمُ", "name_en": "Al-Muntaqim", "translation_en": "The Avenger", "meaning_ar": "الذي يعاقب العصاة والظالمين بعد الإعذار والإنذار."},
    {"id": 82, "name_ar": "العَفُوُّ", "name_en": "Al-Afuww", "translation_en": "The Pardoner", "meaning_ar": "الذي يمحو السيئات ويعفو عن الذنوب."},
    {"id": 83, "name_ar": "الرَّؤُوفُ", "name_en": "Ar-Ra'oof", "translation_en": "The Most Kind", "meaning_ar": "الشديد الرحمة والرأفة بعباده."},
    {"id": 84, "name_ar": "مَالِكُ الْمُلْكِ", "name_en": "Malik-ul-Mulk", "translation_en": "Owner of All Sovereignty", "meaning_ar": "المتصرف في ملكه كيف يشاء يعطي الملك من يشاء."},
    {"id": 85, "name_ar": "ذُو الْجَلَالِ وَالإِكْرَامِ", "name_en": "Dhul-Jalali wal-Ikram", "translation_en": "Lord of Majesty and Generosity", "meaning_ar": "المستحق لأن يُعظم ويُهاب ويُطاع فلا يُعصى."},
    {"id": 86, "name_ar": "الْمُقْسِطُ", "name_en": "Al-Muqsit", "translation_en": "The Equitable", "meaning_ar": "العادل في حكمه المنصف للمظلوم من الظالم."},
    {"id": 87, "name_ar": "الْجَامِعُ", "name_en": "Al-Jami'", "translation_en": "The Gatherer", "meaning_ar": "الذي يجمع الخلائق ليوم القيامة للحساب."},
    {"id": 88, "name_ar": "الْغَنِيُّ", "name_en": "Al-Ghaniyy", "translation_en": "The Self-Sufficient", "meaning_ar": "الذي لا يحتاج إلى شيء من خلقه والكل محتاج إليه."},
    {"id": 89, "name_ar": "الْمُغْنِي", "name_en": "Al-Mughni", "translation_en": "The Enricher", "meaning_ar": "الذي يسد حاجات عباده ويغنيهم بفضله."},
    {"id": 90, "name_ar": "الْمَانِعُ", "name_en": "Al-Mani'", "translation_en": "The Withholder", "meaning_ar": "الذي يمنع العطاء بحكمته ويحمي أولياءه من الشر."},
